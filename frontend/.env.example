# ─────────────────────────────────────────────────────────────────────────
# Valores de desarrollo local. En Vercel, define estas mismas claves VITE_*
# en Project Settings → Environment Variables: Vite las incrusta en el bundle
# DURANTE EL BUILD, así que hay que redesplegar tras cambiarlas.
# Con el frontend en HTTPS, las URLs deben ser https:// y wss:// (si no, el
# navegador bloquea la petición por contenido mixto).
# Para un archivo de referencia con valores de producción (Vercel), usa
# frontend/.env.prod (gitignored; no lo commits).
# Guía completa: docs/deploy-render-vercel.md
# ─────────────────────────────────────────────────────────────────────────

# ── Modo demostración (modal al cargar + datos simulados en el backend) ──
# Con la ESP32 publicando datos reales, poné `false` para ocultar el modal.
# El backend reenvía esos mensajes al dashboard vía WebSocket
# (ws://localhost:8080/ws).
VITE_DEMO_MODE=false

# ── API HTTP del backend (alertas manuales, historial) ──
# Producción: https://<tu-servicio>.onrender.com
VITE_API_URL=http://localhost:8080

# ── WebSocket (datos en tiempo real vía JSON) ──
# Producción: wss://<tu-servicio>.onrender.com/ws  ← el sufijo /ws es obligatorio
# (sin él el navegador intenta wss://host/ y falla). Si omites VITE_WS_URL,
# el cliente la deriva de VITE_API_URL + /ws.
VITE_WS_URL=ws://localhost:8080/ws
VITE_WS_ENABLED=true

# ── Asistente IA (Llama 3.1 8B vía Ollama) ──
# Si la dejas vacía, se deriva de VITE_API_URL + /chat.
VITE_ASSISTANT_URL=
VITE_ASSISTANT_ENABLED=true
# Vacía en dev; en producción el servidor exige ASSISTANT_API_KEY.
VITE_ASSISTANT_API_KEY=

# ── MQTT (broker con soporte WebSocket) ──
# Camino por defecto con datos reales: dejar `false` y recibir todo por el
# WebSocket del backend (recomendado). El backend ya reenvía al dashboard
# todo lo que llega por MQTT al broker, así que suscribirse desde el
# navegador duplicaría las lecturas.
# Si querés que el dashboard se conecte directo al broker (p. ej. EMQX en
# 8084), usá `wss://<host>:8084/mqtt` y un usuario MQTT de solo lectura;
# las credenciales quedarán visibles en el bundle.
VITE_MQTT_URL=ws://localhost:9001
VITE_MQTT_ENABLED=false
VITE_MQTT_CLIENT_ID=aquaponic-dashboard
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# Topics MQTT (ajusta según tu ESP32 / backend)
VITE_MQTT_TOPIC_SENSORS=aquaponic/sensors/#
VITE_MQTT_TOPIC_FISH=aquaponic/fish/#
VITE_MQTT_TOPIC_PLANTS=aquaponic/plants/#
VITE_MQTT_TOPIC_CAMERAS=aquaponic/cameras/#

# URLs de stream de cámaras (MJPEG, HLS, WebRTC gateway, etc.)
VITE_CAMERA_FISH_URL=
VITE_CAMERA_PLANTS_URL=
