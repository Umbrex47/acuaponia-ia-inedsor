# ─────────────────────────────────────────────────────────────────────────
# Valores de desarrollo local. En Vercel, define estas mismas claves VITE_*
# en Project Settings → Environment Variables: Vite las incrusta en el bundle
# DURANTE EL BUILD, así que hay que redesplegar tras cambiarlas.
# Con el frontend en HTTPS, las URLs deben ser https:// y wss:// (si no, el
# navegador bloquea la petición por contenido mixto).
# Guía completa: docs/deploy-render-vercel.md
# ─────────────────────────────────────────────────────────────────────────

# ── Modo demostración (modal al cargar + datos simulados en el backend) ──
# Ojo: public/config.js fija demoMode='false' y el runtime tiene prioridad
# sobre esta variable, así que en el build estático el modal queda apagado.
VITE_DEMO_MODE=true

# ── API HTTP del backend (alertas manuales, historial) ──
# Producción: https://<tu-servicio>.onrender.com
VITE_API_URL=http://localhost:8080

# ── WebSocket (datos en tiempo real vía JSON) ──
# Producción: wss://<tu-servicio>.onrender.com/ws
VITE_WS_URL=ws://localhost:8080/ws
VITE_WS_ENABLED=true

# ── MQTT (broker con soporte WebSocket) ──
# Ruta principal recomendada en producción: dejar VITE_MQTT_ENABLED=false y
# recibir todo por el WebSocket del backend. Si lo activas contra EMQX Cloud,
# usa wss://<host>:8084/mqtt — las credenciales quedarán visibles en el bundle,
# así que crea un usuario MQTT de solo lectura para el navegador.
VITE_MQTT_URL=ws://localhost:9001
VITE_MQTT_ENABLED=true
VITE_MQTT_CLIENT_ID=aquaponic-dashboard
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# Topics MQTT (ajusta según tu ESP32 / backend)
VITE_MQTT_TOPIC_SENSORS=aquaponic/sensors/#
VITE_MQTT_TOPIC_FISH=aquaponic/fish/#
VITE_MQTT_TOPIC_PLANTS=aquaponic/plants/#
VITE_MQTT_TOPIC_CAMERAS=aquaponic/cameras/#

# URLs de stream de cámaras (MJPEG, HLS, WebRTC gateway, etc.)
VITE_CAMERA_FISH_URL=
VITE_CAMERA_PLANTS_URL=
