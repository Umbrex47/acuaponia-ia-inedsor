{
  "name": "aquaponic-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "App móvil para seguimiento del estado de los peces, monitoreo manual de calidad de agua y sistema de notificaciones en tiempo real",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "node scripts/patch-expo-notifications.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.22",
    "expo-asset": "^57.0.17",
    "expo-notifications": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
