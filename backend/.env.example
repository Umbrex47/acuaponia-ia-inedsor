# ─────────────────────────────────────────────────────────────────────────
# Plantilla local. En producción (Render) estas variables se definen en el
# panel del servicio o vía render.yaml — NUNCA subas un .env con secretos.
# Para un archivo de referencia con valores de prod, usa backend/.env.prod
# (gitignored; no lo commits). Guía: docs/deploy-render-vercel.md
# ─────────────────────────────────────────────────────────────────────────

# Puerto HTTP + WebSocket (el dashboard usa ws://localhost:8080/ws)
# En Render, define PORT=8080 (coincide con el EXPOSE del Dockerfile).
PORT=8080

# Broker MQTT (Mosquitto, EMQX, HiveMQ, etc.)
#   Local sin cifrar:  mqtt://localhost:1883
#   Nube con TLS:      mqtts://xxxxx.ala.us-east-1.emqxsl.com:8883
# Con broker en la nube, usuario y clave son obligatorios.
# El cliente mqtt.js valida el certificado con los CA del sistema: no hace
# falta configurar nada extra para EMQX Cloud Serverless en el puerto 8883.
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=aquaponic-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_RECONNECT_MS=3000

# Prefijo de topics (debe coincidir con el ESP32 y frontend/.env)
MQTT_TOPIC_PREFIX=aquaponic

# Simulador de telemetría (solo desarrollo)
MQTT_DEMO_ENABLED=true
MQTT_DEMO_INTERVAL_MS=5000

# ── Alertas por correo (Nodemailer) ──
# Si MAIL_HOST queda vacío, las alertas por correo se deshabilitan.
# Ejemplo con Gmail: host=smtp.gmail.com port=465 secure=true
# (usa una "contraseña de aplicación", no la de tu cuenta).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Aquaponic OS <no-reply@aquaponic.local>
# Destinatarios separados por comas
MAIL_TO=

# ── Alertas por Telegram (Bot API) ──
# 1) Crea un bot con @BotFather y copia el token aquí.
# 2) Obtén el chat_id (habla con tu bot y consulta
#    https://api.telegram.org/bot<TOKEN>/getUpdates, o usa @userinfobot).
# Si TELEGRAM_BOT_TOKEN queda vacío, las alertas por Telegram se deshabilitan.
TELEGRAM_BOT_TOKEN=
# IDs de chat destino separados por comas (usuarios, grupos o canales)
TELEGRAM_CHAT_IDS=

# Habilita/deshabilita el motor de alertas y el anti-spam por sensor (ms)
ALERTS_ENABLED=true
ALERTS_COOLDOWN_MS=300000

# ── Motor de decisiones (control de bomba + reportes) ──
# Apaga todo el motor con DECISION_ENABLED=false.
DECISION_ENABLED=true
# Actuador de la bomba: el comando se publica en <prefix>/commands/<id>
PUMP_ACTUATOR_ID=bomba_agua
# Histéresis por nivel de agua (cm): bajo OFF se apaga (anti-marcha en seco),
# al alcanzar ON se enciende. offLevel debe ser menor que onLevel.
PUMP_ON_LEVEL=24
PUMP_OFF_LEVEL=20
# Tiempo mínimo (ms) en un estado antes de poder cambiarlo (anti-ciclado)
PUMP_MIN_STATE_MS=60000
# Reporte de progreso (correo + Telegram). cron en hora del servidor.
REPORT_ENABLED=true
REPORT_CRON=0 8 * * *
REPORT_WINDOW_HOURS=24

# Evaluación conductual de peces → correo (sin actuadores)
FISH_ASSESSMENT_ENABLED=true
FISH_ASSESS_MAIL_THRESHOLD=50
FISH_ASSESS_MAIL_COOLDOWN_MS=300000

# Evaluación de plantas → correo (sin actuadores)
PLANT_ASSESSMENT_ENABLED=true
PLANT_ASSESS_MAIL_THRESHOLD=50
PLANT_ASSESS_MAIL_COOLDOWN_MS=300000

# ── Base de datos MongoDB (registro de parámetros) ──
# Si MONGODB_URI queda vacío, el registro en base de datos se deshabilita.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://usuario:clave@cluster.mongodb.net
# Render no ofrece MongoDB gestionado: usa MongoDB Atlas (capa M0 gratuita) y
# permite el acceso desde 0.0.0.0/0 (las IP de salida de Render son dinámicas).
MONGODB_URI=
MONGODB_DB_NAME=aquaponic
# Permite apagar solo el guardado sin quitar la conexión
READINGS_PERSIST_ENABLED=true
