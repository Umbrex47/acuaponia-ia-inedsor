# ── Broker MQTT (mismo que usa el backend) ──
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=aquaponic-camera-py

# Prefijo de topics (debe coincidir con backend/.env y frontend)
MQTT_TOPIC_PREFIX=aquaponic

# ── Cámaras a publicar ──
# JSON con la lista de cámaras. Cada objeto:
#   target: "fish" o "plants"  (coincide con el panel del dashboard)
#   source: índice de webcam (0, 1, ...) o URL/RTSP/ruta de archivo
# Ejemplo con dos cámaras:
#   CAMERAS=[{"target":"fish","source":0},{"target":"plants","source":1}]
# Demo con video:
#   CAMERA_SOURCE=../ProyectosM/AIPeces/videos/Video.mp4
CAMERAS=[{"target":"fish","source":0}]

# Alternativa simple (si no usas CAMERAS): una sola cámara
CAMERA_TARGET=fish
CAMERA_SOURCE=0

# ── Codificación / transmisión ──
FPS=5
JPEG_QUALITY=60
FRAME_WIDTH=640
FRAME_HEIGHT=0
RETAIN=false

# ── Detección de peces (YOLO + SORT + conducta) ──
FISH_DETECT_ENABLED=true
FISH_DETECT_MODEL=../fish-detection/models/fish_yolo11s_aquarium.pt
FISH_DETECT_CONF=0.35
FISH_DETECT_EVERY_N=2
FISH_DETECT_OVERLAY=true
FISH_DETECT_CLASS=fish
FISH_BEHAVIOR_WINDOW_SEC=180
FISH_SURFACE_BAND=0.25
FISH_ACTIVITY_LOW=0.08
FISH_ACTIVITY_HIGH=0.35
FISH_SURFACE_THR=0.55
FISH_ASSESS_INTERVAL_SEC=90
FISH_TELEMETRY_EVERY_SEC=5
