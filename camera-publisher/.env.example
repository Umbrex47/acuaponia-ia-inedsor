# ── Broker MQTT (mismo que usa el backend) ──
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=aquaponic-camera-py

# Prefijo de topics (debe coincidir con backend/.env y frontend)
MQTT_TOPIC_PREFIX=aquaponic

# ── Cámaras a publicar ──
# JSON con la lista de cámaras. Cada objeto:
#   target: "fish" o "plants"  (coincide con el panel del dashboard)
#   source: índice de webcam (0, 1, ...) o URL/RTSP/ruta de archivo
# Ejemplo con dos cámaras:
#   CAMERAS=[{"target":"fish","source":0},{"target":"plants","source":1}]
CAMERAS=[{"target":"fish","source":0}]

# Alternativa simple (si no usas CAMERAS): una sola cámara
CAMERA_TARGET=fish
CAMERA_SOURCE=0

# ── Codificación / transmisión ──
FPS=5
JPEG_QUALITY=60
FRAME_WIDTH=640
# FRAME_HEIGHT=0 conserva la relación de aspecto a partir del ancho
FRAME_HEIGHT=0
# RETAIN=true deja el último frame disponible para nuevos clientes
RETAIN=false
