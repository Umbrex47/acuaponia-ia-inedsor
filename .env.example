# ─────────────────────────────────────────────────────────────────────────
# Variables de despliegue (Docker Compose / Coolify).
# Copia a `.env` para `docker compose`, o defínelas en la UI de Coolify.
# Los valores con default funcionan tal cual para una prueba local.
# ─────────────────────────────────────────────────────────────────────────

# ── Puertos publicados en el host (para pruebas / acceso directo) ──
FRONTEND_PORT=3000
BACKEND_PORT=8080
MQTT_TCP_PORT=1883
MQTT_WS_PORT=9001

# ── Frontend (inyectado en runtime como /config.js) ──
# En Coolify, apunta a los dominios públicos del backend (usa https/wss).
#   APP_API_URL=https://api.tu-dominio.com
#   APP_WS_URL=wss://api.tu-dominio.com/ws
APP_API_URL=http://localhost:8080
APP_WS_URL=ws://localhost:8080/ws
APP_WS_ENABLED=true
# MQTT directo del navegador (desactivado por defecto; requiere WSS si se usa).
APP_MQTT_ENABLED=false
APP_MQTT_URL=
APP_MQTT_USERNAME=
APP_MQTT_PASSWORD=
APP_CAMERA_FISH_URL=
APP_CAMERA_PLANTS_URL=
# Modal de aviso al cargar: indica que los datos son simulados.
APP_DEMO_MODE=true

# ── Backend · MQTT / Mongo (apuntan a los servicios internos del compose) ──
MQTT_TOPIC_PREFIX=aquaponic
MQTT_CLIENT_ID=aquaponic-backend
MQTT_USERNAME=
MQTT_PASSWORD=
# Modo demo: publica telemetría simulada sin ESP32 (ideal para la preview).
MQTT_DEMO_ENABLED=true
MONGODB_DB_NAME=aquaponic
READINGS_PERSIST_ENABLED=true

# ── Backend · Alertas por correo (Nodemailer) ──
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Aquaponic OS <no-reply@aquaponic.local>
MAIL_TO=

# ── Backend · Alertas por Telegram (Bot API) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# ── Backend · Motor de alertas y decisiones ──
ALERTS_ENABLED=true
ALERTS_COOLDOWN_MS=300000
DECISION_ENABLED=true
PUMP_ACTUATOR_ID=bomba_agua
PUMP_ON_LEVEL=24
PUMP_OFF_LEVEL=20
PUMP_MIN_STATE_MS=60000
REPORT_ENABLED=true
REPORT_CRON=0 8 * * *
REPORT_WINDOW_HOURS=24
FISH_ASSESSMENT_ENABLED=true
FISH_ASSESS_MAIL_THRESHOLD=50
FISH_ASSESS_MAIL_COOLDOWN_MS=300000
